# Copy to .env.local for local development. All values are optional:
# with none set, the app runs in mock mode with an offline brief analyzer
# and a deterministic mock generation provider — no external API keys needed.

# --- Mode ---
# Mock mode is on by default. Set to "false" to call the real Astra/Higgsfield APIs.
STUDIO_MOCK_MODE=true

# --- Database ---
# Everything is stored in one local SQLite file (created on first start).
# DATABASE_PATH=./data/studio.db

# --- GPT-6 Astra (real brief analysis via the OpenAI Responses API) ---
# With OPENAI_API_KEY set, pasted briefs are analysed by the real model with
# Structured Outputs; without it, a deterministic offline mock is used.
# Set STUDIO_MOCK_MODE=true to force the mock even when a key is present.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-6-astra
# (ASTRA_API_KEY / ASTRA_BASE_URL / ASTRA_MODEL are accepted as fallbacks.)

# --- First-phase AI (drafts the creative brief; Astra then sharpens it) ---
# Any OpenAI-compatible /chat/completions endpoint: a local model (Ollama, LM Studio) or a very cheap hosted one.
# Both must be set to go live; otherwise the offline drafter is used. The endpoint and model can also be saved on
# the Settings page, where they win over these. The key is optional (local models need none).
# DRAFT_AI_BASE_URL=http://localhost:11434/v1
# DRAFT_AI_MODEL=llama3.2
# DRAFT_AI_API_KEY=

# --- Higgsfield (generation provider) ---
# HIGGSFIELD_API_KEY_ID=
# HIGGSFIELD_API_KEY_SECRET=
# HIGGSFIELD_BASE_URL=https://api.higgsfield.ai

# --- Local generation (ComfyUI) ---
# The "Local · ComfyUI image/video" models run on your own machine and cost nothing. They need ComfyUI
# running and a workflow template in comfy-workflows/ (see comfy-workflows/README.md). Mock mode must be off.
# COMFYUI_URL=http://127.0.0.1:8188
# COMFYUI_WORKFLOW_DIR=./comfy-workflows
# COMFYUI_IMAGE_SIZE=1024    # long side in pixels
# COMFYUI_VIDEO_SIZE=768

# --- Economics (all optional; defaults shown) ---
# DEFAULT_CONTINGENCY_PCT=0.2
# MIN_GROSS_MARGIN_PCT=0.45
# REJECT_BELOW_MARGIN_PCT=0.15
# MAX_PRODUCTION_BUDGET_USD=2000   # plan cost + contingency above this is auto-rejected
# MAX_ATTEMPTS_PER_STEP=40         # cap on the model's attempt estimate per step
# MIN_CONFIDENCE_PCT=55            # below this, route to human review
# MAX_MISSING_ASSETS=2             # more missing assets than this, route to human review
# FEE_UPWORK_PCT=0.1
# FEE_FIVERR_PCT=0.2
# FEE_CONTRA_PCT=0
# FEE_EMAIL_PCT=0
# FEE_DIRECT_PCT=0

# --- Misc ---
# OPERATOR_NAME=Operator

# --- Entering API keys on the Settings page ---
# Set a passcode (12+ characters) to allow saving/replacing the OpenAI and Higgsfield keys
# from /settings. Every change must include it; keys are stored encrypted with a key derived
# from it (changing the passcode makes saved keys unreadable, so re-enter them). Without it the
# form is disabled and keys come from environment variables only. A key saved in the UI wins
# over the environment variable; removing it falls back to the variable.
# The same passcode is the login for the whole app (sign in at /login) and the step-up for going
# live from the Settings page. Unset = the app stays open and shows a warning.
# ADMIN_PASSCODE=

# Higgsfield SDK example (index.ts, `npm run hf:example`): "key-id:key-secret".
# Put the real value in .env.local (git-ignored), not here.
HF_CREDENTIALS=
