# Copy to .env.local for local development. All values are optional:
# with none set, the app runs in mock mode with an offline brief analyzer
# and a deterministic mock generation provider — no external API keys needed.

# --- Mode ---
# Mock mode is on by default. Set to "false" to call the real Astra/Higgsfield APIs.
STUDIO_MOCK_MODE=true

# --- Database ---
# SQLite file path. Defaults to ./data/studio.db locally and /tmp/studio.db on Vercel.
# DATABASE_PATH=./data/studio.db

# Durable, shared persistence (needed for serverless hosts like Vercel, where the
# local file is ephemeral). Set both to use a remote Turso / libSQL database instead
# of the local file. Create one with: turso db create && turso db show --url / turso db tokens create
# TURSO_DATABASE_URL=libsql://your-db-name.turso.io
# TURSO_AUTH_TOKEN=

# --- Astra (brief analysis, OpenAI-compatible chat completions) ---
# ASTRA_API_KEY=
# ASTRA_BASE_URL=https://api.openai.com/v1
# ASTRA_MODEL=gpt-6-astra

# --- Higgsfield (generation provider) ---
# HIGGSFIELD_API_KEY_ID=
# HIGGSFIELD_API_KEY_SECRET=
# HIGGSFIELD_BASE_URL=https://api.higgsfield.ai

# --- Economics (all optional; defaults shown) ---
# DEFAULT_CONTINGENCY_PCT=0.2
# MIN_GROSS_MARGIN_PCT=0.45
# REJECT_BELOW_MARGIN_PCT=0.15
# FEE_UPWORK_PCT=0.1
# FEE_FIVERR_PCT=0.2
# FEE_CONTRA_PCT=0
# FEE_EMAIL_PCT=0
# FEE_DIRECT_PCT=0

# --- Misc ---
# OPERATOR_NAME=Operator
